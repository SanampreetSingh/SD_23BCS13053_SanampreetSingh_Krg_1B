        <mxCell id="UT0PzkJqhCXy37AjViVD-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp;Ques 2 :&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp;Design a Whatsapp system with proper following&amp;nbsp; &amp;nbsp;requirements:&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp;1. User Service&lt;br&gt;&amp;nbsp;2. Chat Service&amp;nbsp;&lt;br&gt;&amp;nbsp;3. Group Service&amp;nbsp;&lt;br&gt;&lt;br&gt;Optimize the chat service for handling million of request.&lt;br&gt;Specify the type of connection used in the design.&lt;br&gt;Determine how the design will be done for Last Seen functionality&lt;br&gt;Implement&amp;nbsp; CDC Pipeline in the same architecture.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
